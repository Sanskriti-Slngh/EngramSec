.env
.env.*
!.env.example
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
*.py[cod]

# Runtime artifacts that can contain browser state or local model caches.
agent1/.auth/
agent1/.cache/

# Full browser evidence remains local and reproducible; commit compact reports,
# metrics, manifests, and diagrams instead of hundreds of MB of duplicate JSON.
agent1/experiments/**/checkpoint.json
agent1/experiments/**/run.json
agent1/experiments/**/trace.jsonl
agent1/experiments/**/graph_a.json
# Raw external-evaluator exports can contain per-case expectations. Keep them
# segregated locally; commit only aggregate/category summaries.
agent1/experiments/**/crawlground_results.json
!agent1/experiments/siyucms_10m_comparison/grouped-r1/audited_v2/graph_a.json
!agent1/experiments/validation_content_outcomes_v3/outcomes/graph_a.json
!agent1/experiments/siyucms_search_milestone/graph_a.json
!agent1/experiments/siyucms_search_integrated_v2/graph_a.json

# Preserve exploratory fixture iterations locally; checkpoint the corrected
# baseline/final runs and reports without cluttering Git with setup-only reruns.
agent1/experiments/validation_baseline_778bbbd/
agent1/experiments/validation_content_outcomes_v1/
agent1/experiments/validation_content_outcomes_v2/
agent1/experiments/validation_baseline_778bbbd_v2/posthoc_evaluation.json

# Keep full adversarial fixture runs local; checkpoint their compact measured summaries.
agent1/experiments/search_verifier_adversarial_baseline/**
!agent1/experiments/search_verifier_adversarial_baseline/summary.json
agent1/experiments/search_verifier_adversarial_link_delta/**
agent1/experiments/search_verifier_adversarial_link_delta_final/**
!agent1/experiments/search_verifier_adversarial_link_delta_final/summary.json

# Keep 2026-10-30 crawler raw graphs, traces, and checkpoints locally. The
# reviewed aggregate and selected diagrams are saved in crawler_breakthrough_20261030/.
agent1/experiments/budget_ablation/
agent1/experiments/depth_ablation/
agent1/experiments/document_quota_ablation/
agent1/experiments/fast_ablation/
agent1/experiments/fifo_repeats/
agent1/experiments/frontier_matrix/
agent1/experiments/frontier_state_ablation/
agent1/experiments/heldout_shop_crawler_transfer/
